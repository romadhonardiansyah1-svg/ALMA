[Unit]
Description=ALMA private operations dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/alma
EnvironmentFile=/root/.config/alma/mt5-account.conf
ExecStart=/root/alma/.venv/bin/python -m alma.dashboard_runtime --database /root/alma/var/alma.db --mt5-terminal-id ${ALMA_MT5_TERMINAL_ID}
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/alma/var /root/.config/alma

[Install]
WantedBy=multi-user.target